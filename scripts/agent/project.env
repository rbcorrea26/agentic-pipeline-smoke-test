# scripts/agent/project.env
#
# Identidade do projeto consumidor. Lido por scripts/agent/preflight.sh.
#
# REGRAS:
#   * NENHUM segredo aqui (arquivo versionado) — apenas identidade;
#   * substitua os placeholders de template na adocao (o preflight falha
#     enquanto sobrar algum);
#   * PROJECT_REPO e o repositorio ESPERADO: se o origin do clone for outro, o
#     preflight falha (guarda contra operar no projeto errado).

PROJECT_NAME="agentic-pipeline-smoke-test"
PROJECT_REPO="rbcorrea26/agentic-pipeline-smoke-test"                          # owner/repo (ex.: owner/projeto)
PROJECT_CLONE_URL="https://github.com/rbcorrea26/agentic-pipeline-smoke-test.git"                # URL usada no hook after_create do WORKFLOW.md
PROJECT_DEFAULT_BRANCH="main"      # ex.: main
PROJECT_READY_LABEL="pipeline:ready"            # rotulo de entrada do pipeline
PROJECT_ACP_COMMAND="$HOME/automation/bin/cline --acp"            # agente ACP lancado pelo Symphony
                                                         # (ex.: $HOME/automation/bin/cline --acp)
